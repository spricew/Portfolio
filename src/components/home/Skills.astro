---
import SectionTitle from "@/components/ui/SectionTitle.astro";
import SkillsIcon from "@/icons/SkillsIcon.astro";
import CambridgeLogo from "@/icons/skills/CambridgeLogo.astro";
import ScrumLogo from "@/icons/skills/ScrumLogo.astro";
import CiscoLogo from "@/icons/skills/CiscoLogo.astro";

interface CertItem {
    issuer: string;
    field: string;
    level: string;
    titleFallback: string;
    titleKey: "skillCambridge" | "skillScrum" | "skillCisco";
    tags: string[];
    accent: string;
    Logo: typeof CambridgeLogo;
}

const items: CertItem[] = [
    {
        issuer: "Cambridge",
        field: "Language",
        level: "B2",
        titleFallback: "Cambridge B2 English Certificate",
        titleKey: "skillCambridge",
        tags: ["CEFR B2", "Reading and Writing", "Speaking"],
        accent: "from-tertiary-300 to-primary-400",
        Logo: CambridgeLogo,
    },
    {
        issuer: "Scrum",
        field: "Agile",
        level: "SF",
        titleFallback: "Scrum Foundation Certificate",
        titleKey: "skillScrum",
        tags: ["Agile", "Roles and Events", "Artifacts"],
        accent: "from-secondary-300 to-tertiary-300",
        Logo: ScrumLogo,
    },
    {
        issuer: "Cisco",
        field: "Networks",
        level: "CCNA",
        titleFallback: "Cisco CCNA (V7) Introduction Certificate",
        titleKey: "skillCisco",
        tags: ["Networking", "Routing and Switching", "CCNA Intro"],
        accent: "from-primary-400 to-secondary-300",
        Logo: CiscoLogo,
    },
];
---

<section id="certifications" class="relative w-full overflow-x-clip">
    <div class="fade-up-view flex justify-center">
        <SectionTitle
            title="Skills"
            Icon={SkillsIcon}
            titleKey="sectionSkills"
        />
    </div>

    <!-- cinematic-center header -->
    <h3
        class="mx-auto mt-6 max-w-4xl text-center font-['Figtree'] font-semibold text-balance text-white"
        style={"font-size: clamp(2.2rem, 4.5vw, 3.75rem); line-height: 1.05; letter-spacing: -0.02em;"}
    >
        <span data-i18n="certHeadingA">Proof of</span>

        <span data-i18n="certHeadingB">craft, certified.</span>
    </h3>

    <!-- horizontal accordion -->
    <div
        class="cert-grid mt-12 grid grid-cols-1 grid-flow-dense gap-5 md:grid-cols-3"
    >
        {
            items.map((item, index) => (
                <article
                    tabindex="0"
                    data-slice={index}
                    class="cert-slice group relative flex overflow-hidden rounded-4xl bg-white/[0.07] p-6 ring-1 ring-white/15 transition-all duration-500 hover:bg-white/[0.09] hover:ring-white/30 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-tertiary-300 md:min-h-[26rem] md:p-8"
                >
                    <span
                        aria-hidden="true"
                        class={`absolute inset-y-0 left-0 w-1 bg-gradient-to-b ${item.accent}`}
                    />
                    <span
                        aria-hidden="true"
                        class="pointer-events-none absolute -right-2 -bottom-6 font-['Figtree'] leading-none font-bold text-white/[0.06] transition-all duration-700 ease-out select-none group-hover:scale-105 group-hover:text-white/[0.11] text-[5.5rem] md:text-[7rem]"
                    >
                        {item.level}
                    </span>

                    <div class="relative flex w-full items-start gap-5 md:flex-col md:items-center md:gap-6">
                        <span class="cert-logo block shrink-0 overflow-hidden rounded-2xl bg-white/10 p-2 ring-1 ring-white/20">
                            <item.Logo class="block size-12 object-contain transition-transform duration-700 ease-out group-hover:scale-105 md:size-16" />
                        </span>

                        <div
                            aria-hidden="true"
                            class="cert-compact hidden flex-1 flex-col items-center justify-center gap-4 md:flex"
                        >
                            <span class="rotate-180 text-sm font-semibold tracking-[0.35em] text-white/55 uppercase [writing-mode:vertical-rl]">
                                {item.issuer}
                            </span>
                        </div>

                        <div class="cert-detail min-w-0 flex-1 md:absolute md:inset-0 md:flex md:flex-col md:items-center md:justify-center md:p-8 md:text-center">
                            <span class="inline-block rounded-full bg-white/5 px-3.5 py-1 text-xs font-medium tracking-[0.18em] text-tertiary-300 uppercase ring-1 ring-white/15">
                                {item.field}
                            </span>
                            <h4 class="mt-3 font-['Figtree'] text-xl font-semibold text-balance text-white md:text-2xl">
                                <span data-i18n={item.titleKey}>
                                    {item.titleFallback}
                                </span>
                            </h4>
                            <p class="mt-1 text-sm font-medium text-white/60 md:text-base">
                                {item.issuer}
                            </p>
                            <ul class="mt-4 flex flex-wrap gap-2 md:justify-center">
                                {item.tags.map((tag) => (
                                    <li class="rounded-full px-3.5 py-1 text-[0.8rem] font-medium tracking-wide text-white/70 ring-1 ring-white/15 transition-colors duration-300 hover:text-white hover:ring-tertiary-300/50">
                                        {tag}
                                    </li>
                                ))}
                            </ul>
                        </div>
                    </div>
                </article>
            ))
        }
    </div>
</section>

<style>
    /* image scale and fade on scroll */
    .cert-logo {
        transform: scale(0.8);
    }

    @supports (animation-timeline: view()) {
        .cert-logo {
            animation: cert-logo-in 0.7s ease-out forwards;
            animation-timeline: view();
            animation-range: entry 90% cover 40%;
        }

        @keyframes cert-logo-in {
            to {
                transform: scale(1);
            }
        }
    }

    /* horizontal accordion: expanding grid fractions via :has */
    @media (min-width: 768px) {
        .cert-grid {
            grid-template-columns: 1fr 1fr 1fr;
            transition: grid-template-columns 0.6s
                cubic-bezier(0.22, 1, 0.36, 1);
        }

        .cert-grid:has([data-slice="0"]:hover, [data-slice="0"]:focus-within) {
            grid-template-columns: 2.2fr 1fr 1fr;
        }

        .cert-grid:has([data-slice="1"]:hover, [data-slice="1"]:focus-within) {
            grid-template-columns: 1fr 2.2fr 1fr;
        }

        .cert-grid:has([data-slice="2"]:hover, [data-slice="2"]:focus-within) {
            grid-template-columns: 1fr 1fr 2.2fr;
        }

        .cert-compact {
            opacity: 1;
            transition: opacity 0.4s ease-out;
        }

        .cert-slice:hover .cert-compact,
        .cert-slice:focus-within .cert-compact {
            opacity: 0;
        }

        /* Fixed line measure: the detail fades in only once the column
           has settled, so text never visibly rewraps mid-animation.
           On close it hides instantly while the column collapses. */
        .cert-detail {
            opacity: 0;
            transform: translateY(16px);
            visibility: hidden;
            pointer-events: none;
            transition:
                opacity 0s,
                transform 0s,
                visibility 0s;
        }

        .cert-detail h4 {
            text-wrap: stable;
        }

        .cert-slice:hover .cert-detail,
        .cert-slice:focus-within .cert-detail {
            opacity: 1;
            transform: translateY(0);
            visibility: visible;
            pointer-events: auto;
            transition:
                opacity 0.6s ease-out 0.35s,
                transform 0.6s cubic-bezier(0, 0.8, 0, 0.987) 0.35s,
                visibility 0s linear 0s;
        }
    }

    @media (max-width: 767.98px) {
        .cert-compact {
            display: none;
        }
    }

    .cert-slice {
        animation: cert-in 0.7s ease-out backwards;
        animation-timeline: view();
        animation-range: entry 10% cover 60%;
    }

    @keyframes cert-in {
        from {
            transform: translateY(48px) scale(0.94);
            opacity: 0;
        }
        to {
            transform: translateY(0) scale(1);
            opacity: 1;
        }
    }

    @supports (corner-shape: squircle) {
        article {
            border-radius: 3.5rem;
            corner-shape: squircle;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .cert-slice,
        .cert-logo {
            animation: none;
        }
        .cert-slice {
            opacity: 1;
            transform: none;
        }
        .cert-logo {
            transform: none;
        }
        .cert-grid,
        .cert-compact,
        .cert-detail {
            transition: none;
        }
        .cert-detail {
            opacity: 1;
            transform: none;
            visibility: visible;
            pointer-events: auto;
        }
        .cert-slice:hover .cert-detail,
        .cert-slice:focus-within .cert-detail {
            transition: none;
        }
    }
</style>
