---
const {
  Icon,
  IconHeight = "h-10",
  IconWidth = "w-10",
  IconTitle = "",
  delay
} = Astro.props;
---

<!-- Mosaico de tecnología: reveal con escala vía .scale-in-view (global) y
     súper-elipse orgánica vía .squircle-tile (ver DESIGN.md). -->
<div
  class="tech-card squircle-tile scale-in-view relative flex items-center justify-center min-h-18 rounded-3xl overflow-hidden bg-surface-raised
  ring-1 ring-line-strong"
  title={IconTitle}
  style={`animation-delay: ${delay ?? "0s"};`}
>
  <Icon class={`block ${IconHeight} ${IconWidth}`} />
  <Icon class={`absolute -z-1 right-18 top-14 -rotate-10 ${IconHeight} ${IconWidth} blur-xl opacity-80 scale-150`}/>
</div>

<script>
  import { revealOnView } from "../../scripts/reveal";

  revealOnView(".tech-card", 0.2);
</script>

<style>
  /* For optimization: "will change", it's like an indication*/
  /* Only apply for components that really need that preparation for its animation interaction like modals */
  .tech-card {
    will-change: transform, opacity, filter;
  }
</style>