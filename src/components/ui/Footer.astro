---
import MailIcon from "@/icons/MailIcon.astro";
import GithubIcon from "@/icons/GithubIcon.astro";
import LinkedInIcon from "@/icons/linkedinIcon.astro";

const baseStyle = `inline-flex p-2 transition duration-300 ease-out hover:text-accent hover:scale-105`;
---

<footer class="flex flex-col items-center gap-4 py-12 ring-1 ring-line-soft
 text-sm font-display text-white">

    <div class="flex flex-col items-center gap-1">
        <span class="font-normal">
            <span data-i18n="footerDeveloped">Developed by</span>
            <a href="https://github.com/spricew" 
            class="font-semibold text-tertiary-300"
            target="_blank"
            rel="noopener noreferrer">
                @spricew
            </a>
        </span>
        <p class="font-normal">
            <span data-i18n="footerBuiltWith">Built with</span>
            <span class="font-semibold">AstroJs</span> 
            and 
            <span class="font-semibold">TailwindCSS</span>
        </p>
    </div>
    
    <ul class="h-full flex gap-x-4 text-base text-white">
        <li>
            <a href="mailto:medinaheyder@gmail.com" class={`${baseStyle}`} aria-label="Email" title="Email">
                <MailIcon class="size-5" />
            </a>
        </li>
        <li>
            <a href="https://github.com/spricew" class={`${baseStyle}`} target="_blank" aria-label="Github" title="Github">
                <GithubIcon class="size-5" />
            </a>
        </li>
        <li>
            <a href="https://www.linkedin.com/in/heyderix/" class={`${baseStyle}`} target="_blank" aria-label="LinkedIn" title="LinkedIn">
                <LinkedInIcon class="size-5" />
            </a>
        </li>
    </ul>
</footer>

