---
import type { ProjectProps } from "@/data/projects";
import { Image } from "astro:assets";
import Pill from "./Pill.astro";
import CustomButton from "./CustomButton.astro";
import PreviewIcon from "@/icons/PreviewIcon.astro";
import GithubOutlineIcon from "@/icons/GithubOutlineIcon.astro";
import MeshButton from "./MeshButton.astro";

type Props = ProjectProps;

const {
  imageSrc,
  projectTitle,
  projectDescription,
  previewLink,
  githubLink,
  techs = [],
  titleKey,
  descKey,
} = Astro.props as Props;
---

<!-- Editorial index row: full-width glass card, cover right on desktop, banner on mobile -->
<article
  class="group proj-row relative grid w-full grid-flow-dense grid-cols-1 overflow-hidden rounded-4xl bg-white/[0.07] ring-1 ring-white/15 backdrop-blur-md transition-all duration-500 hover:-translate-y-1 hover:bg-white/[0.09] hover:ring-tertiary-300/60 md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] md:items-stretch md:gap-8 md:p-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]"
>
  <span aria-hidden="true" class="proj-cover relative block aspect-[16/9] w-full overflow-hidden md:order-2 md:aspect-auto">
    <Image
      src={imageSrc}
      alt=""
      widths={[400, 700, 1000]}
      sizes="(min-width: 64rem) 40vw, 100vw"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
    />
  </span>

  <div class="relative order-2 flex min-w-0 flex-col gap-3 p-6 md:order-1 md:justify-center md:p-0">
    <div class="flex flex-wrap gap-1.5">
      {techs.map((tech) => <Pill pillText={tech} />)}
    </div>

    <h3
      class="line-clamp-2 font-['Figtree'] font-semibold text-balance text-white transition-colors duration-300 group-hover:text-tertiary-300"
      style={"font-size: clamp(1.65rem, 2.4vw, 2.25rem);"}
    >
      <span data-i18n={titleKey}>{projectTitle}</span>
    </h3>

    <p class="max-w-2xl line-clamp-3 text-sm text-pretty text-white/80 md:text-base">
      <span data-i18n={descKey}>{projectDescription}</span>
    </p>

    <div class="flex flex-wrap gap-2 pt-1">
      {
        previewLink && (
          <MeshButton
            text="Preview"
            Icon={PreviewIcon}
            textSize="text-sm"
            textColor="text-slate-800"
            href={previewLink}
          />
        )
      }
      {
        githubLink && (
          <CustomButton
            text="Code"
            Icon={GithubOutlineIcon}
            textSize="text-sm"
            textColor="text-white"
            bgColor="bg-zinc-900/70"
            href={githubLink}
            extraClass="font-medium rounded-xl"
          />
        )
      }
    </div>
  </div>
</article>

<style>
  .proj-row {
    animation: rowIn 0.6s ease-out backwards;
    animation-timeline: view();
    animation-range: entry 90% cover 35%;
  }

  @keyframes rowIn {
    0% {
      transform: translateY(60px);
      opacity: 0;
    }

    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @supports (corner-shape: squircle) {
    .proj-row {
      border-radius: 3.5rem;
      corner-shape: squircle;
    }
  }

  /* image scale and fade on scroll (wrapper-level, keeps img hover zoom intact) */
  @supports (animation-timeline: view()) {
    .proj-cover {
      animation: proj-cover-in 0.8s ease-out backwards;
      animation-timeline: view();
      animation-range: entry 90% cover 45%;
    }

    @keyframes proj-cover-in {
      from {
        transform: scale(0.8);
        opacity: 0.4;
      }
      to {
        transform: scale(1);
        opacity: 1;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .proj-row {
      animation: none;
      transform: none;
    }
    .proj-cover {
      animation: none;
    }
  }
</style>
