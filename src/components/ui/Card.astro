---
import type { ProjectProps } from "@/data/projects";
import { Image } from "astro:assets";
import Pill from "./Pill.astro";
import CustomButton from "./CustomButton.astro";
import PreviewIcon from "@/icons/PreviewIcon.astro";
import GithubOutlineIcon from "@/icons/GithubOutlineIcon.astro";
import MeshButton from "./MeshButton.astro";

type Props = ProjectProps & { featured?: boolean; key?: string };

const {
  imageSrc,
  projectTitle,
  projectDescription,
  previewLink,
  githubLink,
  techs = [],
  featured = false,
} = Astro.props as Props;
---

<article
  class:list={[
    "fade-up-card group relative flex flex-col justify-end overflow-hidden rounded-4xl ring-1 ring-white/20 transition-all duration-500 hover:ring-tertiary-300/60",
    featured
      ? "min-h-[24rem] md:col-span-2 md:min-h-[26rem]"
      : "min-h-[19rem] md:min-h-[22rem]",
  ]}
>
  <Image
    src={imageSrc}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
  />

  <!-- Gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-neutral-950/70 to-neutral-950/10"></div>

  <!-- Actions -->
  <div class="absolute right-5 top-5 flex gap-2">
    {
      previewLink && (
        <MeshButton
          text="Preview"
          Icon={PreviewIcon}
          textSize="text-sm"
          textColor="text-slate-800"
          href={previewLink}
        />
      )
    }
    {
      githubLink && (
        <CustomButton
          text="Code"
          Icon={GithubOutlineIcon}
          textSize="text-sm"
          textColor="text-white"
          bgColor="bg-zinc-900/70"
          href={githubLink}
          extraClass="font-medium rounded-xl"
        />
      )
    }
  </div>

  <!-- Content -->
  <div
    class:list={[
      "relative flex flex-col gap-3 p-6 md:p-8",
      featured ? "md:max-w-2xl" : "",
    ]}
  >
    <div class="flex flex-wrap-reverse gap-1.5">
      {techs.map((tech) => <Pill pillText={tech} key={tech} />)}
    </div>

    <h3
      class:list={[
        "line-clamp-2 font-semibold text-white transition-colors duration-300 group-hover:text-tertiary-300",
        featured ? "text-2xl md:text-3xl" : "text-2xl",
      ]}
    >
      {projectTitle}
    </h3>

    <p
      class:list={[
        "text-sm text-pretty text-white/85 line-clamp-4",
        featured ? "md:text-base md:line-clamp-3" : "",
      ]}
    >
      {projectDescription}
    </p>
  </div>
</article>

<style>
  .fade-up-card {
    animation: slideInCard 0.6s ease-out backwards;
    animation-timeline: view();
    animation-range: entry 20% cover 40%;
  }

  @keyframes slideInCard {
    0% {
      transform: translateY(100px);
    }

    100% {
      transform: translateY(0);
    }
  }

  @supports (corner-shape: squircle) {
    .fade-up-card {
      border-radius: 4.5rem;
      corner-shape: squircle;
    }
  }
</style>