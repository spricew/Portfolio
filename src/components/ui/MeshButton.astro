---
const {
    text = "Button",
    Icon,
    textSize = "text-base",
    iconSize = "size-5",
    // Tinta oscura del sistema: legible sobre el lavado de acento claro
    textColor = "text-tertiary-950",
    href = "#",
} = Astro.props;
---

<a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class={`
        inline-flex items-center justify-start gap-2
        rounded-full font-display font-semibold ${textSize} ${textColor} 
        bg-linear-to-r from-[#FFF0F5] via-[#FFF8DC] to-[#E0FFFF]
        transition-all duration-300 ease-out cursor-pointer hover:scale-105 
        overflow-hidden px-4 py-2
        active:scale-95  
    `}
>
    <!-- Ícono fijo en la izquierda -->
    <Icon class={`${iconSize}`} />

    <!-- Texto que aparece sin empujar el ícono -->
    <span>
        {text}
    </span>
</a>