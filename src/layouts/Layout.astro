---
import '../styles/global.css';  

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = "Heyder Medina — Junior Software Developer. Portfolio with web development projects: Astro, Next.js, React, TypeScript and more.", noindex = false } = Astro.props;

const site = Astro.site ?? new URL(Astro.url.pathname, Astro.url);
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImageURL = new URL("/og-image.png", site);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site.href}#website`,
      url: site.href,
      name: "Heyder Medina",
      description,
      inLanguage: "en",
    },
    {
      "@type": "Person",
      "@id": `${site.href}#person`,
      name: "Heyder Medina",
      url: site.href,
      image: ogImageURL.href,
      jobTitle: "Junior Software Developer",
      description,
      email: "mailto:medinaheyder@gmail.com",
      sameAs: [
        "https://github.com/spricew",
        "https://www.linkedin.com/in/heyderix/",
      ],
    },
  ],
};
---  

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<meta name="theme-color" content="#021a03" />
		<title>{title}</title>
		<link rel="canonical" href={canonicalURL.href} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Heyder Medina" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL.href} />
		<meta property="og:image" content={ogImageURL.href} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Heyder Medina — Junior Software Developer" />
		<meta property="og:locale" content="en_US" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL.href} />
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		<link
		rel="preload"
		href="/fonts/Urbanist-Regular.woff2"
		as="font"
		type="font/woff2"
		crossorigin
	  />
		<link
			rel="preload"
			href="/fonts/Urbanist-Medium.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/Urbanist-SemiBold.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
		rel="preload"
		href="/fonts/Figtree-Variable.woff2"
		as="font"
		type="font/woff2"
		crossorigin
		/>
	</head>
	<body class="relative min-h-dvh">
		<div class="absolute top-0 z-[-2] h-full w-full bg-neutral-950 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
		<slot />
		<script>
			import Lenis from 'lenis';

			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			// Solo desktop: dispositivo con puntero fino (mouse/trackpad), sin depender del ancho de pantalla
			const isDesktop = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

			if (!prefersReducedMotion && isDesktop) {
				const lenis = new Lenis({
					lerp: 0.1,
					wheelMultiplier: 1,
					anchors: true,
				});

				function raf(time: number) {
					lenis.raf(time);
					requestAnimationFrame(raf);
				}
				requestAnimationFrame(raf);
			}
		</script>
		<script src="../scripts/lang.ts"></script>
	</body>
</html>