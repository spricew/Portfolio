---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/ui/Navbar.astro";
import Welcome from "../components/home/Welcome.astro";
import Technologies from "../components/home/Technologies.astro";
import Projects from "../components/home/Projects.astro";
import Education from "../components/home/Education.astro";
import Skills from "../components/home/Skills.astro";
import About from "../components/home/About.astro";
import Footer from "../components/ui/Footer.astro"
---

<Layout title="Heyder Medina - Portfolio" description="Heyder Medina — Junior Software Developer. Portfolio with web development projects: Astro, Next.js, React, TypeScript and more.">
	<Navbar />
	<main class="relative flex flex-col h-fit w-full py-12 lg:py-24 px-8 md:px-12 xl:px-48 gap-y-24 overflow-x-clip">
		<Welcome />
		<Technologies />
		<Projects />
		<Education />
		<Skills />
		<About />
	</main>
	<Footer />
</Layout>
