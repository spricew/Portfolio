---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/ui/Navbar.astro";
import Footer from "@/components/ui/Footer.astro";
import CustomButton from "@/components/ui/CustomButton.astro";
import HomeIcon from "@/icons/HomeIcon.astro";
---

<Layout title="404 - Page Not Found" description="The page you are looking for does not exist." noindex>
	<Navbar />
	<main class="relative flex flex-col items-center justify-center h-[80dvh] pb-20 w-full px-8 text-center gap-8">
		<h1 class="text-4xl md:text-9xl font-display font-bold tracking-tight
			bg-linear-to-b from-white to-ink-faint bg-clip-text text-transparent scale-in" style="animation-delay: .1s">
			404
		</h1>

		<p class="text-xl md:text-2xl text-ink-soft max-w-md slide-in" style="animation-delay: .3s" data-i18n="notFoundMessage">
			This page doesn't exist or has been moved.
		</p>

		<!-- Botón de retorno: mismo componente de botón que el resto del sitio -->
		<div class="slide-in" style="animation-delay: .5s">
			<CustomButton
				text="Back to home"
				Icon={HomeIcon}
				textSize="text-lg"
				padding="px-6 py-3"
				textColor="text-white"
				hoverBgColor="hover:bg-surface-overlay"
				href="/"
				external={false}
			/>
		</div>
	</main>
	<Footer />
</Layout>